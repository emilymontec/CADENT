# Database (PostgreSQL - managed instance recommended, e.g. Neon/Supabase/RDS)
DATABASE_URL="postgresql://user:password@localhost:5432/github_wrapped"

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# GitHub OAuth App (create at https://github.com/settings/developers)
# Scopes: read:user, repo (public_repo is enough for MVP scope: public repos only)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Encryption key used to encrypt GitHubAccount.accessToken / refreshToken at rest
# generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=""

# Job queue (Inngest) - https://www.inngest.com
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# Insights Engine (Fase 1) - narración con IA de insights ya calculados.
# Opcional: sin esta key, el Insights Engine cae automáticamente a
# plantillas deterministas (lib/insights/templates.ts).
ANTHROPIC_API_KEY=""
